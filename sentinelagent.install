post_install() {
  if ! getent passwd sentinelone >/dev/null; then
    useradd --system --user-group --home-dir /opt/sentinelone/home --shell /usr/bin/nologin sentinelone
  fi

  install -d -o sentinelone -g sentinelone -m 0750 \
    /opt/sentinelone/log /opt/sentinelone/cgroups /opt/sentinelone/cgroups/memory \
    /opt/sentinelone/crash_dumps /opt/sentinelone/crash_dumps/.current \
    /opt/sentinelone/mount /opt/sentinelone/rpm_mount
  chown -R sentinelone:sentinelone /opt/sentinelone
  chown -R root:root /opt/sentinelone/home /opt/sentinelone/lib /opt/sentinelone/ebpfs
  chown -R root:sentinelone /opt/sentinelone/bin
  chmod 0750 /opt/sentinelone/bin
  chmod g+r /opt/sentinelone/bin/sentinelone-agent
  chown root:root /opt/sentinelone/configuration/sentinelone.service

  /opt/sentinelone/bin/sentinelctl control set-service-type systemd
  systemctl daemon-reload
  printf '%s\n' 'Set your management token with sentinelctl, then enable and start sentinelone.service.'
}

post_upgrade() {
  post_install
}

pre_remove() {
  if systemctl is-active --quiet sentinelone.service; then
    /opt/sentinelone/bin/sentinelctl control stop || return 1
    if systemctl is-active --quiet sentinelone.service; then
      printf '%s\n' 'Agent is still running; removal requires it to stop first.' >&2
      return 1
    fi
  fi
  systemctl disable sentinelone.service
}

post_remove() {
  systemctl daemon-reload
  printf '%s\n' 'Local state and the sentinelone account remain in /opt/sentinelone; see README.md for cleanup.'
}
